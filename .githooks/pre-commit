#!/usr/bin/env bash
#
# Blocks commits that contain secrets.
#
# .gitignore stops whole secret FILES from being committed. This catches the
# likelier accident: a real token pasted into a file that is already tracked —
# wrangler.toml, a README example, a test script.
#
# Enabled per-clone with:  git config core.hooksPath .githooks
# Bypass (only when you are certain):  git commit --no-verify

set -uo pipefail

fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

red() { printf '\033[31m%s\033[0m\n' "$1"; }
yellow() { printf '\033[33m%s\033[0m\n' "$1"; }

# ---------------------------------------------------------------------------
# 1. Files that should never be committed, whatever .gitignore says.
#    (A file added with `git add -f` bypasses .gitignore entirely.)
# ---------------------------------------------------------------------------
while IFS= read -r file; do
  case "$file" in
    *.example|*.sample) continue ;;
  esac
  case "$(basename "$file")" in
    .dev.vars|.env|.env.*|*.pem|*.key|*.p12|*.pfx|*.jks|id_rsa|id_ed25519|credentials.json)
      red "BLOCKED  $file — this file holds secrets and must not be committed."
      fail=1
      ;;
  esac
done <<< "$staged"

# ---------------------------------------------------------------------------
# 2. Secret-shaped content inside otherwise-normal files.
#    Patterns are deliberately specific to keep false positives low.
# ---------------------------------------------------------------------------
# Note: every grep below uses `-e` so patterns beginning with '-' are treated
# as patterns rather than options.
patterns=(
  'BEGIN [A-Z ]*PRIVATE KEY'                         # PEM / OPENSSH private keys
  'AKIA[0-9A-Z]{16}'                                 # AWS access key id
  'gh[pousr]_[A-Za-z0-9]{36,}'                       # GitHub tokens
  'xox[baprs]-[A-Za-z0-9-]{10,}'                     # Slack tokens
  'sk-[A-Za-z0-9]{32,}'                              # OpenAI-style keys
)

for file in $staged; do
  # Only scan text files that still exist in the worktree.
  [ -f "$file" ] || continue
  if file "$file" 2>/dev/null | grep -qi 'binary'; then continue; fi

  added=$(git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' || true)
  [ -z "$added" ] && continue

  for pattern in "${patterns[@]}"; do
    if printf '%s' "$added" | grep -Eq -e "$pattern"; then
      red "BLOCKED  $file — looks like a credential (matched: $pattern)"
      fail=1
    fi
  done

  # Long, high-entropy values assigned to a secret-sounding name.
  # Placeholders (dev-only-..., REPLACE_WITH_..., <your-token>) are allowed
  # through, since they are the whole point of the .example files.
  suspicious=$(printf '%s' "$added" \
    | grep -Ei '(SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE_?KEY)[A-Z_]*[[:space:]]*[=:][[:space:]]*["'"'"']?[A-Za-z0-9+/_-]{24,}' \
    | grep -Eiv 'dev-only|replace_with|your-|example|changeme|change-me|placeholder|xxxx|\*\*\*' || true)

  if [ -n "$suspicious" ]; then
    red "BLOCKED  $file — a secret-looking value is assigned to a credential name:"
    printf '%s\n' "$suspicious" | sed 's/^/           /' | cut -c1-120
    fail=1
  fi
done

if [ "$fail" -ne 0 ]; then
  echo
  yellow "Commit aborted. Move the value into .dev.vars (local) or set it with:"
  yellow "    npx wrangler secret put <NAME>"
  yellow "If this is genuinely a false positive: git commit --no-verify"
  exit 1
fi

exit 0
